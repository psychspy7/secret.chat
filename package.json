{
  "name": "kitty-corp-private-meeting",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node mobile/scripts/build-website.mjs",
    "preview": "node mobile/scripts/preview-website.mjs",
    "check": "node --check src/main.js && node --check src/crypto.js && node tests/crypto-test.mjs",
    "check:integration": "node tests/supabase-integration.mjs",
    "provision:host-keypair": "node tests/provision-host-keypair.mjs",
    "setup:workspace": "npm ci && npm --prefix mobile ci",
    "check:all": "npm run check && npm --prefix mobile run check && node --test tests/mobile-backend-edge.test.mjs && node --test tests/website-routing.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
